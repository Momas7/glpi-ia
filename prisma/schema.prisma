generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  REQUESTER
  AGENT
  TEAM_LEAD
  ADMIN
}

enum TicketStatus {
  NEW
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketType {
  INCIDENT
  REQUEST
}

enum CommentSource {
  WEB
  EMAIL
  AI_DRAFT
  API
}

enum TicketSource {
  WEB
  API
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model Team {
  id         String       @id @default(cuid())
  name       String       @unique
  /// Interruptor da IA por equipe (a triagem não roda para chamados da equipe quando falso).
  aiEnabled  Boolean      @default(true)
  categories Category[]
  members    TeamMember[]
  tickets    Ticket[]
}

model Category {
  id            String     @id @default(cuid())
  name          String
  parentId      String?
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryTree")
  defaultTeamId String?
  defaultTeam   Team?      @relation(fields: [defaultTeamId], references: [id])
  tickets       Ticket[]

  @@unique([name, parentId])
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String?
  role         Role
  active       Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())

  sessions       Session[]
  teams          TeamMember[]
  invitesCreated Invite[]
  passwordResets PasswordReset[]
  requested      Ticket[]        @relation("Requester")
  assigned       Ticket[]        @relation("Assignee")
  comments       Comment[]
  attachments    Attachment[]
  events         TicketEvent[]
  auditLogs      AuditLog[]
  aiDecisions    AiSuggestion[]
  ratings        TicketRating[]
  kbCreated      KbArticle[]     @relation("KbCreatedBy")
  kbUpdated      KbArticle[]     @relation("KbUpdatedBy")
  apiKeys        ApiKey[]
  incidentGroups IncidentGroup[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([email])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model TeamMember {
  userId String
  teamId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
}

model Ticket {
  id          String       @id @default(cuid())
  number      Int          @unique @default(autoincrement())
  title       String
  description String
  status      TicketStatus @default(NEW)
  priority    Priority     @default(MEDIUM)
  type        TicketType   @default(REQUEST)
  requesterId String
  requester   User         @relation("Requester", fields: [requesterId], references: [id])
  assigneeId  String?
  assignee    User?        @relation("Assignee", fields: [assigneeId], references: [id])
  teamId      String?
  team        Team?        @relation(fields: [teamId], references: [id])
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  resolvedAt  DateTime?
  closedAt    DateTime?
  source      TicketSource @default(WEB)
  apiKeyId    String?
  apiKey      ApiKey?      @relation(fields: [apiKeyId], references: [id])
  externalRef String?

  aiSuggestions   AiSuggestion[]
  /// Solução escrita ao marcar como Resolvido (obrigatória); alimenta a base de conhecimento.
  resolution      String?
  rating          TicketRating?
  embedding       TicketEmbedding?
  /// Vetor enquanto o chamado está aberto (duplicados e incidentes); some ao resolver/fechar.
  openVector      OpenTicketVector?
  incidentGroupId String?
  incidentGroup   IncidentGroup?    @relation(fields: [incidentGroupId], references: [id], onDelete: SetNull)

  // SLA (minutos úteis; prazos sempre recalculados a partir da criação)
  slaFirstResponseMinutes      Int?
  slaResolutionMinutes         Int?
  firstResponseDue             DateTime?
  resolutionDue                DateTime?
  firstRespondedAt             DateTime?
  pausedAt                     DateTime?
  pausedMinutes                Int       @default(0)
  firstResponseBusinessMinutes Int?
  resolutionBusinessMinutes    Int?
  slaWarnedAt                  DateTime?
  slaBreachedAt                DateTime?
  /// Coluna GERADA no Postgres (migration 20261002000400): resolutionDue só para chamado ativo e não pausado.
  /// Usada na ordem "vence primeiro". Somente leitura: nunca escrever.
  slaSortDue                   DateTime?

  comments    Comment[]
  attachments Attachment[]
  events      TicketEvent[]

  @@unique([apiKeyId, externalRef])
  @@index([status, teamId, assigneeId])
  @@index([createdAt])
  @@index([resolvedAt])
  @@index([firstRespondedAt])
  @@index([requesterId])
  @@index([incidentGroupId])
}

model Comment {
  id          String        @id @default(cuid())
  ticketId    String
  ticket      Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId    String
  author      User          @relation(fields: [authorId], references: [id])
  body        String
  internal    Boolean       @default(false)
  source      CommentSource @default(WEB)
  externalRef String?
  /// Rascunho da IA: fontes citadas [{ kind, id, number?, title }].
  sources     Json?
  createdAt   DateTime      @default(now())

  @@unique([ticketId, externalRef])
  @@index([ticketId, createdAt])
}

model Attachment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  filename   String
  storedName String   @unique
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

model TicketEvent {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  type      String
  data      Json
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/**
 * Ações administrativas (convites, papéis, equipes, categorias, SLA, chaves de API).
 */
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  data       Json
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
}

/**
 * Chave usada por integrações (n8n). Só o hash fica guardado; o segredo aparece uma vez na criação.
 */
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String    @unique
  keyHash     String    @unique
  scopes      String[]
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  tickets     Ticket[]
}

/**
 * Registro de cada aviso enviado ao n8n (o corpo não é guardado aqui).
 */
model WebhookDelivery {
  id          String         @id @default(cuid())
  eventId     String         @unique
  type        String
  ticketId    String?
  subjectId   String?
  status      DeliveryStatus @default(PENDING)
  attempts    Int            @default(0)
  lastError   String?
  createdAt   DateTime       @default(now())
  deliveredAt DateTime?

  @@index([status, createdAt])
}

/**
 * Prazos por prioridade, em minutos úteis.
 */
model SlaPolicy {
  id                   String   @id @default(cuid())
  priority             Priority @unique
  firstResponseMinutes Int
  resolutionMinutes    Int
}

/**
 * Expediente por dia da semana (0 = domingo … 6 = sábado). Dia sem linha não tem expediente.
 */
model BusinessHours {
  id          String @id @default(cuid())
  weekday     Int    @unique
  startMinute Int
  endMinute   Int
}

model Holiday {
  id   String   @id @default(cuid())
  date DateTime @unique @db.Date
  name String
}

enum AiSuggestionKind {
  TRIAGE
  DUPLICATE
  SUMMARY
}

enum AiSuggestionStatus {
  PENDING
  ACCEPTED
  EDITED
  REJECTED
}

enum AiOutcome {
  OK
  FAILED
  SKIPPED
  BUDGET
}

/// Proposta da IA para um chamado. A pessoa decide; a IA nunca aplica sozinha.
model AiSuggestion {
  id          String             @id @default(cuid())
  ticketId    String
  ticket      Ticket             @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  kind        AiSuggestionKind
  /// Triagem: { categoryId, priority, teamId, basis: { categoryId, priority, teamId } }
  payload     Json
  confidence  Float
  status      AiSuggestionStatus @default(PENDING)
  decidedById String?
  decidedBy   User?              @relation(fields: [decidedById], references: [id])
  decidedAt   DateTime?
  createdAt   DateTime           @default(now())
  /// Gerada pelo seed de demonstração.
  demo        Boolean            @default(false)

  @@unique([ticketId, kind])
  @@index([status, kind])
}

/// Uma linha por chamada ao LLM. `maskedInput` só guarda texto MASCARADO e é limpo após a retenção.
/// `ticketId` não tem chave estrangeira de propósito: o log sobrevive à exclusão do chamado.
model AiAuditLog {
  id           String    @id @default(cuid())
  createdAt    DateTime  @default(now())
  provider     String
  model        String
  jobType      String
  ticketId     String?
  inputTokens  Int
  outputTokens Int
  costUsd      Decimal   @db.Decimal(12, 6)
  latencyMs    Int
  inputHash    String
  outcome      AiOutcome
  error        String?
  maskedInput  String?
  /// Linha gerada pelo seed de demonstração (nunca uso real).
  demo         Boolean   @default(false)

  @@index([createdAt])
  @@index([jobType, createdAt])
}

/// Avaliação do atendimento pelo solicitante: uma por chamado (CHECK de 1 a 5 e do comentário no SQL).
model TicketRating {
  id        String   @id @default(cuid())
  ticketId  String   @unique
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  raterId   String
  rater     User     @relation(fields: [raterId], references: [id])
  stars     Int
  comment   String?
  createdAt DateTime @default(now())
  /// Gerada pelo seed de demonstração.
  demo      Boolean  @default(false)
}

/// Artigo da base de conhecimento. Só publicado entra no RAG.
model KbArticle {
  id          String    @id @default(cuid())
  title       String
  body        String
  published   Boolean   @default(false)
  createdById String
  createdBy   User      @relation("KbCreatedBy", fields: [createdById], references: [id])
  updatedById String
  updatedBy   User      @relation("KbUpdatedBy", fields: [updatedById], references: [id])
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  chunks      KbChunk[]

  @@index([published])
}

/// Trecho de artigo com vetor (768). A coluna `embedding` é lida e escrita só por SQL cru.
model KbChunk {
  id          String                      @id @default(cuid())
  articleId   String
  article     KbArticle                   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  position    Int
  text        String
  contentHash String
  embedding   Unsupported("vector(768)")?

  @@index([articleId])
}

/// Vetor de um chamado resolvido (título + descrição + solução). Coluna `embedding` só por SQL cru.
model TicketEmbedding {
  ticketId    String                     @id
  ticket      Ticket                     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  contentHash String
  embedding   Unsupported("vector(768)")
  indexedAt   DateTime                   @default(now())
}

enum IncidentStatus {
  OPEN
  CLOSED
}

/// Muitos chamados parecidos em pouco tempo (queda geral). Fecha sozinho quando todos terminam, ou à mão.
model IncidentGroup {
  id         String         @id @default(cuid())
  title      String
  status     IncidentStatus @default(OPEN)
  detectedAt DateTime       @default(now())
  closedAt   DateTime?
  closedById String?
  closedBy   User?          @relation(fields: [closedById], references: [id])
  tickets    Ticket[]

  @@index([status])
}

/// Vetor de um chamado aberto (título + descrição). Coluna `embedding` só por SQL cru.
model OpenTicketVector {
  ticketId    String                     @id
  ticket      Ticket                     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  contentHash String
  embedding   Unsupported("vector(768)")
  createdAt   DateTime                   @default(now())
}

/// Batimento do worker: a página de saúde sabe se ele está vivo.
model WorkerHeartbeat {
  service String   @id
  beatAt  DateTime
}
