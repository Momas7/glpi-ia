generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  REQUESTER
  AGENT
  TEAM_LEAD
  ADMIN
}

enum TicketStatus {
  NEW
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TicketType {
  INCIDENT
  REQUEST
}

enum CommentSource {
  WEB
  EMAIL
  AI_DRAFT
  API
}

enum TicketSource {
  WEB
  API
}

enum DeliveryStatus {
  PENDING
  DELIVERED
  FAILED
}

model Team {
  id         String       @id @default(cuid())
  name       String       @unique
  categories Category[]
  members    TeamMember[]
  tickets    Ticket[]
}

model Category {
  id            String     @id @default(cuid())
  name          String
  parentId      String?
  parent        Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryTree")
  defaultTeamId String?
  defaultTeam   Team?      @relation(fields: [defaultTeamId], references: [id])
  tickets       Ticket[]

  @@unique([name, parentId])
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String?
  role         Role
  active       Boolean   @default(true)
  failedLogins Int       @default(0)
  lockedUntil  DateTime?
  createdAt    DateTime  @default(now())

  sessions       Session[]
  teams          TeamMember[]
  invitesCreated Invite[]
  passwordResets PasswordReset[]
  requested      Ticket[]        @relation("Requester")
  assigned       Ticket[]        @relation("Assignee")
  comments       Comment[]
  attachments    Attachment[]
  events         TicketEvent[]
  auditLogs      AuditLog[]
  apiKeys        ApiKey[]
}

model Session {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model Invite {
  id          String    @id @default(cuid())
  email       String
  role        Role
  tokenHash   String    @unique
  expiresAt   DateTime
  usedAt      DateTime?
  revokedAt   DateTime?
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())

  @@index([email])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model TeamMember {
  userId String
  teamId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([userId, teamId])
}

model Ticket {
  id          String       @id @default(cuid())
  number      Int          @unique @default(autoincrement())
  title       String
  description String
  status      TicketStatus @default(NEW)
  priority    Priority     @default(MEDIUM)
  type        TicketType   @default(REQUEST)
  requesterId String
  requester   User         @relation("Requester", fields: [requesterId], references: [id])
  assigneeId  String?
  assignee    User?        @relation("Assignee", fields: [assigneeId], references: [id])
  teamId      String?
  team        Team?        @relation(fields: [teamId], references: [id])
  categoryId  String?
  category    Category?    @relation(fields: [categoryId], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  resolvedAt  DateTime?
  closedAt    DateTime?
  source      TicketSource @default(WEB)
  apiKeyId    String?
  apiKey      ApiKey?      @relation(fields: [apiKeyId], references: [id])
  externalRef String?

  comments    Comment[]
  attachments Attachment[]
  events      TicketEvent[]

  @@index([status, teamId, assigneeId])
  @@index([createdAt])
  @@index([requesterId])
  @@unique([apiKeyId, externalRef])
}

model Comment {
  id        String        @id @default(cuid())
  ticketId  String
  ticket    Ticket        @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorId  String
  author    User          @relation(fields: [authorId], references: [id])
  body      String
  internal  Boolean       @default(false)
  source      CommentSource @default(WEB)
  externalRef String?
  createdAt   DateTime      @default(now())

  @@index([ticketId, createdAt])
  @@unique([ticketId, externalRef])
}

model Attachment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploaderId String
  uploader   User     @relation(fields: [uploaderId], references: [id])
  filename   String
  storedName String   @unique
  mimeType   String
  size       Int
  createdAt  DateTime @default(now())

  @@index([ticketId])
}

model TicketEvent {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?    @relation(fields: [actorId], references: [id])
  type      String
  data      Json
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

/** Ações administrativas (convites, papéis, equipes, categorias, SLA, chaves de API). */
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  actor      User     @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String
  data       Json
  createdAt  DateTime @default(now())

  @@index([targetType, targetId, createdAt])
}

/** Chave usada por integrações (n8n). Só o hash fica guardado; o segredo aparece uma vez na criação. */
model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String    @unique
  keyHash     String    @unique
  scopes      String[]
  createdById String
  createdBy   User      @relation(fields: [createdById], references: [id])
  createdAt   DateTime  @default(now())
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  tickets     Ticket[]
}

/** Registro de cada aviso enviado ao n8n (o corpo não é guardado aqui). */
model WebhookDelivery {
  id          String         @id @default(cuid())
  eventId     String         @unique
  type        String
  ticketId    String?
  subjectId   String?
  status      DeliveryStatus @default(PENDING)
  attempts    Int            @default(0)
  lastError   String?
  createdAt   DateTime       @default(now())
  deliveredAt DateTime?

  @@index([status, createdAt])
}
