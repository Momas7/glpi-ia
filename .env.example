# Copie para .env e ajuste. Nunca commite o .env.
# Use a mesma senha de POSTGRES_PASSWORD abaixo no lugar de SENHA
DATABASE_URL=postgresql://glpi:SENHA@localhost:5432/glpi_ia
# Gere com: openssl rand -hex 16
POSTGRES_PASSWORD=
# Gere com: openssl rand -hex 32
SESSION_SECRET=
APP_URL=http://localhost:3000

# IA (Fase 3+). Com AI_ENABLED=false nada é enviado a nenhum LLM.
# LLM_PROVIDER: fake (testes/demo, sem chave), gemini (dev) ou anthropic (produção).
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=gemini
AI_ENABLED=false
# Teto diário de gasto estimado, em USD
AI_DAILY_BUDGET=5
# Abaixo desta confiança (0 a 1) a triagem não sugere nada
AI_TRIAGE_MIN_CONFIDENCE=0.6
# Dias que o texto mascarado fica no log de auditoria da IA
AI_AUDIT_RETENTION_DAYS=30
# Modelo da triagem (vazio = o modelo pequeno do provider)
AI_MODEL_TRIAGE=
# Chave do Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Chave do Claude: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# E-mail (Fase 2)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

UPLOAD_DIR=./uploads
# Senha dos usuários fictícios do seed (somente demonstração)
SEED_DEMO_PASSWORD=

# Quantos proxies seus (ex.: Caddy) ficam na frente do app; define em qual posição do X-Forwarded-For está o IP real
TRUSTED_PROXY_HOPS=1
# Equipe que recebe chamados sem categoria/equipe, para não ficarem invisíveis aos técnicos
DEFAULT_INTAKE_TEAM=Suporte N1
# Dias em "Resolvido" até o chamado fechar sozinho, se o solicitante não reabrir
AUTO_CLOSE_DAYS=7

# Integração com o n8n (opcional). Sem URL, os avisos só vão para o log.
# N8N_WEBHOOK_URL=https://n8n.suaempresa.com/webhook/chamados
# Gere com: openssl rand -hex 32
# N8N_WEBHOOK_SECRET=

# Fuso usado no horário comercial do SLA
APP_TIMEZONE=America/Sao_Paulo
