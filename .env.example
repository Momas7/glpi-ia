# Copie para .env e ajuste. Nunca commite o .env.
# Use a mesma senha de POSTGRES_PASSWORD abaixo no lugar de SENHA
DATABASE_URL=postgresql://glpi:SENHA@localhost:5432/glpi_ia
# Gere com: openssl rand -hex 16
POSTGRES_PASSWORD=
# Gere com: openssl rand -hex 32
SESSION_SECRET=
APP_URL=http://localhost:3000

# IA (Fase 3+)
LLM_PROVIDER=gemini
EMBEDDING_PROVIDER=gemini
AI_ENABLED=false
AI_DAILY_BUDGET=5
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# E-mail (Fase 2)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

UPLOAD_DIR=./uploads
# Senha dos usuários fictícios do seed (somente demonstração)
SEED_DEMO_PASSWORD=
