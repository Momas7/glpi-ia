# Produção local. Copie com `scripts/prod-init.sh` (ele gera os segredos); nunca commite o .env.prod.

# --- Segredos (gerados pelo prod-init.sh; deixe em branco aqui) ---
SESSION_SECRET=
POSTGRES_PASSWORD=
N8N_WEBHOOK_SECRET=

# --- Acesso ---
# Portas no seu computador (acima de 1024 porque o Podman sem root não abre as baixas)
HTTPS_PORT=8443
HTTP_PORT=8080
# APP_URL=https://localhost:8443

# --- Backup ---
# Pasta dos backups (os scripts e a página de saúde usam a mesma)
BACKUP_DIR=./backups

# --- IA (desligada por padrão) ---
AI_ENABLED=false
LLM_PROVIDER=fake
EMBEDDING_PROVIDER=fake
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
AI_DAILY_BUDGET=5

# --- n8n (opcional) ---
N8N_WEBHOOK_URL=

# --- Logs ---
LOG_LEVEL=info
